---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import heroLogo from "../assets/hero-logo.webp";
import nolanPhoto from "../assets/nolan.jpg";
import routes from "../data/routes.json";

interface Stop {
  when: string;
  place: string;
  description: string;
  type: "festival" | "scouting";
  tbd: boolean;
}

const nextStops = (routes as Stop[]).slice(0, 3);
---

<Layout
  title="Sounds So Far | Nolan Haines"
  description="Sounds So Far: a racecar trailer rebuilt as a traveling studio and stage, rollin' from state to state, starting in Austin for South by Southwest and ending in Austin for ACL Festival, March to October 2028."
>
<header class="hero">
  <div class="wrap">
    <p class="by">Nolan Haines presents</p>
    <h1 class="visually-hidden">Sounds So Far</h1>
  </div>
  <Image src={heroLogo} alt="Sounds So Far Music Studio" width={1600} class="hero-full" loading="eager" />
  <div class="wrap">
    <p>A racecar trailer turned studio, rollin&rsquo; from state to state, starting in Austin, Texas for South by Southwest and ending in Austin for ACL Festival, March to October 2028. It stops for festivals and finds up-and-coming artists in every town. Each one plays a live set, sits down for a podcast conversation, and gets their favorite cocktail.</p>
    <a class="btn" href="/apply">Play on the trailer</a>
  </div>
</header>

<main>
<section>
  <div class="wrap">
    <h2>A stage that comes to you</h2>
    <p class="lead">Most new artists wait for a stage. We bring one to them. The trailer parks, the gear goes up, and the set goes out live. The conversation lands on the podcast and the clips land on every platform after.</p>
    <div class="grid">
      <div><h3>Live sets</h3><p>Sets are recorded and streamed from the trailer so anyone, anywhere can watch.</p></div>
      <div><h3>Open mic between stops</h3><p>In between the big festivals, the trailer opens up. Walk up, plug in, play.</p></div>
      <div><h3>A talk and a drink</h3><p>Every artist gets a podcast interview, before or after their set, with their favorite cocktail in hand, sometimes mixed by a bartender they love. Every drink also comes in a non-alcoholic version.</p></div>
    </div>
  </div>
</section>

<section class="route-preview">
  <div class="wrap">
    <h2>The route</h2>
    <p class="lead">Seven months on the road, starting at South by Southwest and ending back in Austin. Here's what's coming up.</p>
    <ol class="route-preview-list">
      {nextStops.map((stop) => (
        <li>
          <span class="route-preview-when">{stop.when}</span>
          <span class="route-preview-place">{stop.place}</span>
        </li>
      ))}
    </ol>
    <a class="btn" href="/route">See the full route</a>
  </div>
</section>

<section class="alt">
  <div class="wrap founder">
    <figure>
      <Image src={nolanPhoto} alt="Nolan Haines standing in a mountain meadow" width={500} />
    </figure>
    <div>
      <h2>Meet Nolan</h2>
      <blockquote class="quote">&ldquo;The world is craving authenticity and genuine creativity in the age of digital and AI. I&rsquo;m going to bring a grounded, down-to-earth concept to fruition in order to quench that thirst for life we all crave.&rdquo;<cite>Nolan Haines</cite></blockquote>
      <a class="btn" href="/meet-nolan">Read Nolan's story</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Stay in the loop</h2>
    <p class="lead">Get occasional emails about where the trailer's headed next.</p>
    <NewsletterForm idPrefix="home" />
  </div>
</section>
</main>
</Layout>
