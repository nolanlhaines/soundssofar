---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import kingbee from "../assets/gallery-kingbee.jpg";
import bartonSprings from "../assets/gallery-barton-springs.jpg";
import sunset from "../assets/gallery-sunset.jpg";
import recordShop from "../assets/gallery-record-shop.jpg";
import sign from "../assets/gallery-sign.jpg";
import meadow from "../assets/gallery-meadow.jpg";
import palms from "../assets/gallery-palms.jpg";
import marfa from "../assets/gallery-marfa.jpg";
import bus from "../assets/gallery-bus.jpg";

// TODO: placeholder address, see TODO.md
const CONTACT_EMAIL = "hello@nolanhaines.com";
---

<Layout
  title="Contact | Sounds So Far"
  description="Get in touch with Sounds So Far, and follow the tour."
>
<main>
<section>
  <div class="wrap">
    <h2>Contact</h2>
    <p class="lead">Artists should use the <a href="/apply">artist application</a> instead — this is for press, festivals, and everyone else.</p>
    <p class="lead">Send a message below, or email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> directly.</p>

    <form
      id="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="_gotcha"
      action="/thanks"
      class="apply"
      novalidate
      aria-labelledby="contact-form-title"
    >
      <h3 id="contact-form-title" class="apply-title">Send a message</h3>
      <div id="contact-errors" class="errsum" role="alert" tabindex="-1" hidden></div>

      <!-- Honeypot: hidden from sighted users and screen readers; real visitors never fill this in. -->
      <div class="field visually-hidden" aria-hidden="true">
        <label for="c-hp">Leave this field blank</label>
        <input id="c-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="two">
        <div class="field"><label for="c-name">Name <span class="req">*</span></label><input id="c-name" name="Name" type="text" autocomplete="name" required></div>
        <div class="field"><label for="c-email">Email <span class="req">*</span></label><input id="c-email" name="Email" type="email" autocomplete="email" required></div>
      </div>
      <div class="field">
        <label for="c-topic">Topic <span class="req">*</span></label>
        <select id="c-topic" name="Topic" required>
          <option value="">Choose one</option>
          <option>Artist</option>
          <option>Venue or festival</option>
          <option>Press</option>
          <option>Other</option>
        </select>
      </div>
      <div class="field"><label for="c-message">Message <span class="req">*</span></label><textarea id="c-message" name="Message" required></textarea></div>

      <div class="actions">
        <button class="btn" type="submit">Send message</button>
      </div>
      <div id="contact-status" class="status" role="status" hidden></div>
    </form>
  </div>
</section>

<section class="deep">
  <div class="wrap">
    <h2>Follow along</h2>
    <p class="lead">Links to follow the tour, watch live sets and listen to the podcast are coming soon.</p>
    <div class="photo-strip">
      <figure class="polaroid"><Image src={kingbee} alt="A live band performing at King Bee" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={marfa} alt="Nolan outside the Prada Marfa art installation at night" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={bartonSprings} alt="Swimmers at Barton Springs in Austin" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={bus} alt="Nolan looking over an old bus by the water" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={recordShop} alt="A DJ booth beside a wall of records" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={meadow} alt="Nolan standing in a mountain meadow" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={sign} alt="Nolan holding up a railroad crossing sign" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={palms} alt="Two people walking through a sunlit palm grove" width={400} height={400} /></figure>
      <figure class="polaroid"><Image src={sunset} alt="A glowing sunset cloud over a vineyard" width={400} height={400} /></figure>
    </div>
  </div>
</section>
</main>
<script src="../scripts/contact-form.js"></script>
</Layout>
