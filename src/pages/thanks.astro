---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thanks | Sounds So Far"
  description="Thanks for applying to Sounds So Far."
  noindex
>
<main>
  <section>
    <div class="wrap">
      <h1>Thanks for applying</h1>
      <p class="lead">Your application made it to Sounds So Far. Nolan will follow up by email.</p>
      <a class="btn" href="/">Back to the site</a>
    </div>
  </section>
</main>
</Layout>

<style>
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.7rem);
    font-weight: 700;
    margin-bottom: 18px;
  }
</style>
